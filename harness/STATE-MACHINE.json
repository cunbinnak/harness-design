{
  "version": 4,
  "initial_state": "BOOTSTRAP",
  "states": {
    "BOOTSTRAP": {
      "description": "Khởi tạo, chưa có wave nào. Target reset sau /done-wave.",
      "allowed_commands": [
        "intake-requirement"
      ],
      "allowed_spawn": false,
      "read_only_spawn_always": true
    },
    "INTAKE": {
      "description": "Intake done. /review-document loop revise theo feedback. /approve-document mark approved. /start-wave (gate approved=true) chuyen WAVE_OPEN.",
      "allowed_commands": [
        "intake-requirement",
        "review-document",
        "approve-document",
        "start-wave"
      ],
      "allowed_spawn": true,
      "read_only_spawn_always": true,
      "agent_behavior": "flat_orchestration_by_main_agent"
    },
    "WAVE_OPEN": {
      "description": "Wave đã materialize agents + KG + MATRIX. Chờ start dev.",
      "allowed_commands": [
        "start-dev"
      ],
      "allowed_spawn": false,
      "read_only_spawn_always": true
    },
    "DEV": {
      "description": "Dev các boundary của wave (mỗi /start-dev 1 boundary, lặp được). Xong hết → /review-dev review cả wave.",
      "allowed_commands": [
        "start-dev",
        "review-dev"
      ],
      "allowed_spawn": true,
      "read_only_spawn_always": true
    },
    "REVIEW_DEV": {
      "description": "Review agent ghi review-findings.md + trả open_findings (KHÔNG tự spawn). MAIN đọc → spawn fix Mode B → re-review tới open_findings==0. Gate no_open_findings chặn complete.",
      "allowed_commands": [
        "dev-handoff"
      ],
      "allowed_spawn": true,
      "read_only_spawn_always": true,
      "agent_behavior": "internal_review_fix_loop"
    },
    "DEV_HANDOFF": {
      "description": "Verify docker-compose + infra ready cho test agent chạy local.",
      "allowed_commands": [
        "test-plan"
      ],
      "allowed_spawn": true,
      "read_only_spawn_always": true
    },
    "TEST_PLAN": {
      "description": "Sinh test-case-registry.md cho wave.",
      "allowed_commands": [
        "test-execute"
      ],
      "allowed_spawn": true,
      "read_only_spawn_always": true
    },
    "TEST_EXECUTE": {
      "description": "Build service local + run auto test, log bug (origin=auto) vào bugs.md. KHÔNG fix ở đây. Transition MANUAL_TEST sau khi chạy (pass HAY fail).",
      "allowed_commands": [],
      "allowed_spawn": true,
      "read_only_spawn_always": true,
      "agent_behavior": "test_execute_only",
      "auto_transition_on": {
        "test_result": "any"
      }
    },
    "MANUAL_TEST": {
      "description": "UAT manual + clear bug. Infra vẫn UP. /fix-bugs (Mode A) fix bug auto (từ test-execute) + manual (UAT); fix re-run TC verify, KHÔNG gọi review-agent.",
      "allowed_commands": [
        "fix-bugs",
        "end-wave"
      ],
      "allowed_spawn": true,
      "read_only_spawn_always": true,
      "agent_behavior": "fix_bugs_mode_a"
    },
    "DONE": {
      "description": "Wave kết thúc, UAT signed. Chờ teardown hoặc CR amendment.",
      "allowed_commands": [
        "done-wave",
        "apply-cr"
      ],
      "allowed_spawn": false,
      "read_only_spawn_always": true
    }
  },
  "transitions": [
    {
      "from": "BOOTSTRAP",
      "to": "INTAKE",
      "trigger": "intake-requirement",
      "evidence_required": {
        "step": 1
      }
    },
    {
      "from": "INTAKE",
      "to": "INTAKE",
      "trigger": "intake-requirement",
      "evidence_required": {
        "step": "2|3|4",
        "user_confirmed_prev": true
      }
    },
    {
      "from": "INTAKE",
      "to": "INTAKE",
      "trigger": "review-document",
      "evidence_required": {
        "feedback_processed": true
      },
      "note": "Revise loop. User cung cap feedback, agent revise doc. KHONG set approved."
    },
    {
      "from": "INTAKE",
      "to": "INTAKE",
      "trigger": "approve-document",
      "evidence_required": {
        "approved": true
      },
      "note": "User mark docs OK. Set approved=true in STATE. KHONG transition state. /start-wave gate check approved."
    },
    {
      "from": "INTAKE",
      "to": "WAVE_OPEN",
      "trigger": "start-wave",
      "evidence_required": {
        "approved": true,
        "wave_n": "any"
      }
    },
    {
      "from": "WAVE_OPEN",
      "to": "DEV",
      "trigger": "start-dev",
      "evidence_required": {
        "boundary": "any"
      }
    },
    {
      "from": "DEV",
      "to": "DEV",
      "trigger": "start-dev",
      "evidence_required": {
        "boundary": "any"
      },
      "note": "Dev thêm boundary khác trong cùng wave (multi-boundary). Xong hết mới /review-dev."
    },
    {
      "from": "DEV",
      "to": "REVIEW_DEV",
      "trigger": "review-dev",
      "evidence_required": {}
    },
    {
      "from": "REVIEW_DEV",
      "to": "DEV_HANDOFF",
      "trigger": "dev-handoff",
      "evidence_required": {
        "coverage_pct": {
          "min": 80
        },
        "review_result": "pass"
      }
    },
    {
      "from": "DEV_HANDOFF",
      "to": "TEST_PLAN",
      "trigger": "test-plan",
      "evidence_required": {
        "docker_compose_ok": true
      }
    },
    {
      "from": "TEST_PLAN",
      "to": "TEST_EXECUTE",
      "trigger": "test-execute",
      "evidence_required": {
        "test_cases_count": {
          "min": 1
        }
      }
    },
    {
      "from": "TEST_EXECUTE",
      "to": "MANUAL_TEST",
      "trigger": "_auto",
      "evidence_required": {
        "test_result": "any"
      },
      "auto": true,
      "note": "Auto-transition khi test-execute complete (có test_result, pass HAY fail). Bug auto fix qua /fix-bugs ở MANUAL_TEST."
    },
    {
      "from": "MANUAL_TEST",
      "to": "MANUAL_TEST",
      "trigger": "fix-bugs",
      "evidence_required": {
        "bug_id": "any"
      },
      "note": "In-state loop, agent chain fix + review"
    },
    {
      "from": "MANUAL_TEST",
      "to": "DONE",
      "trigger": "end-wave",
      "evidence_required": {
        "uat_signed": true,
        "no_open_bugs": true
      }
    },
    {
      "from": "DONE",
      "to": "BOOTSTRAP",
      "trigger": "done-wave",
      "evidence_required": {
        "teardown_ok": true
      }
    },
    {
      "from": "DONE",
      "to": "INTAKE",
      "trigger": "apply-cr",
      "evidence_required": {
        "cr_id": "any"
      },
      "note": "CR amendment chỉ từ DONE, không từ state khác"
    }
  ]
}
