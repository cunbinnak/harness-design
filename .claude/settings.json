{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "ADLC Design Harness v4 — project-level settings. Hooks dispatch qua scripts/hooks/dispatcher.py. Personal permissions ở settings.local.json (gitignored).",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Read(**/target/**)",
      "Read(**/build/**)",
      "Read(**/dist/**)",
      "Read(**/node_modules/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.git/objects/**)",
      "Read(**/.gradle/**)",
      "Read(**/.next/**)",
      "Read(**/*.class)",
      "Read(**/*.pyc)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(gh release:*)",
      "Bash(gh pr create:*)",
      "Bash(npm publish:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)"
    ],
    "allow": [
      "Edit",
      "Write",
      "Bash",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "UserPromptSubmit"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "Notification"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "PreCompact"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "PreToolUse"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "PreToolUse"
            ]
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "PreToolUse"
            ]
          }
        ]
      },
      {
        "matcher": "Skill|SlashCommand",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "PreToolUse"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "PostToolUse"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "SubagentStop"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "Stop"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "scripts/hooks/dispatcher.py",
              "--event",
              "SessionEnd"
            ]
          }
        ]
      }
    ]
  }
}
